.DS_Store
node_modules/
data.json
action-log.json
*.js.map
eslint.config.mjs

# Defense-in-depth: resources/shell-integration/{zsh,bash}/ should only ever
# contain the two checked-in rc scripts. Nothing should write here at
# runtime any more (see pty_helper.py's build_child_env), but this is a
# safety net against ever accidentally committing a stray history/cache file.
resources/shell-integration/*/.bash_history
resources/shell-integration/*/Library/

# Local Claude Code config and skills (includes the settings.local.json the
# plugin auto-provisions when this repo is opened as a vault)
.claude/

# Obsidian vault working files (using Obsidian as an IDE for this repo)
.obsidian/
app.css

# Personal reference notes, not part of the shipped plugin or its docs
docs/
.claude/settings.local.json
