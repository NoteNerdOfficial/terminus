{
  "name": "terminus",
  "version": "1.0.45",
  "description": "A real terminal with shell integration and beginner-friendly command help, plus a multi-agent Agent inbox for several Claude Code sessions and a review workflow for their edits: word-level diffs, undo, backlink-breakage warnings, and more.",
  "main": "main.js",
  "scripts": {
    "predev": "node scripts/generateResourceFiles.mjs",
    "dev": "node esbuild.config.mjs",
    "prebuild": "node scripts/generateResourceFiles.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "pretest": "tsc -noEmit -skipLibCheck -p test/tsconfig.json && node scripts/buildTests.mjs",
    "test": "node --test --test-reporter=spec test/.build/"
  },
  "keywords": [],
  "author": "NoteNerd",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/node": "^22.10.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "obsidian": "^1.7.2",
    "terminus-node-bridge": "^1.5.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "esbuild": "^0.28.2",
    "tslib": "2.4.0",
    "typescript": "^5.7.2"
  }
}
